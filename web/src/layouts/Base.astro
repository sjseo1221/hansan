---
// 공통 틀: 지연 안내(NFR-REL-02) · 자료 기준 일시(NFR-REL-01) · 예측 고지(NFR-LEGAL-02) · 순위 고지(NFR-LEGAL-03) · 출처(NFR-LEGAL-01)
interface Props {
  title: string;
}
const { title } = Astro.props;
const path = Astro.url.pathname;
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content="수도권·강원·충청 나들이 장소 중 덜 붐빌 곳을 날짜별로 추천합니다." />
    <link rel="icon" href="data:," />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Rubik:wght@400;500;600&display=swap" rel="stylesheet" />
  </head>
  <body>
    <a class="skip" href="#main">본문 바로가기</a>
    <div id="main-wrapper">
      <aside id="sidebar" class="left-sidebar" aria-label="메뉴">
        <a href="/" class="brand">한산</a>
        <nav>
          <ul>
            <li>
              <a href="/" class:list={["side-link", { active: path === "/" }]} aria-current={path === "/" ? "page" : undefined}>
                <svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" /><path d="M9 22V12h6v10" /></svg>
                추천 피드
              </a>
            </li>
            <li>
              <a href="#asof" class="side-link">
                <svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="10" /><path d="M12 16v-4" /><path d="M12 8h.01" /></svg>
                자료 기준·고지
              </a>
            </li>
            <li>
              <a href="#sources-box" class="side-link">
                <svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><ellipse cx="12" cy="5" rx="9" ry="3" /><path d="M3 5v14a9 3 0 0 0 18 0V5" /><path d="M3 12a9 3 0 0 0 18 0" /></svg>
                데이터 출처
              </a>
            </li>
          </ul>
        </nav>
      </aside>
      <div class="page-wrapper">
        <header class="top">
          <button id="nav-toggle" class="nav-toggle" type="button" aria-controls="sidebar" aria-expanded="false" aria-label="메뉴 열기">☰</button>
          <a href="/" class="brand brand-m">한산</a>
          <form id="search" class="search" action="/" role="search">
            <label for="q" class="sr">장소 검색</label>
            <svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="8" /><path d="m21 21-4.3-4.3" /></svg>
            <input id="q" name="q" type="search" autocomplete="off" placeholder="장소 검색" />
          </form>
        </header>
        <div id="stale" class="notice" role="status" hidden></div>
        <main id="main">
          <slot />
        </main>
        <footer class="foot">
          <p id="asof">자료 기준 일시를 불러오는 중입니다.</p>
          <p>혼잡 예측은 참고 정보이며 실제와 다를 수 있습니다. 방문 전 운영 여부를 꼭 확인하세요.</p>
          <p>추천 순위는 광고나 금전적 대가의 영향을 받지 않습니다.</p>
          <details id="sources-box">
            <summary>데이터 출처</summary>
            <ul id="sources"></ul>
          </details>
        </footer>
      </div>
    </div>
    <button id="chat-open" class="chat-open" type="button" hidden>대화로 찾기</button>
    <dialog id="chat" aria-labelledby="chat-title">
      <div class="chat-head">
        <h2 id="chat-title">대화로 찾기</h2>
        <button id="chat-close" type="button" aria-label="대화 닫기">닫기</button>
      </div>
      <p class="chat-hint">예: "이번 토요일 아이랑 갈 만한 실내 장소", "더 한산한 곳으로". 대화 내용은 저장하지 않아요.</p>
      <div id="chat-log" class="chat-log" aria-live="polite"></div>
      <form id="chat-form" class="chat-form">
        <label for="chat-input" class="sr">원하는 조건</label>
        <input id="chat-input" maxlength="200" autocomplete="off" placeholder="200자 이내" />
        <button type="submit">보내기</button>
      </form>
    </dialog>
    <style is:global>
      /* 디자인 토큰 — FreeDash 테마. 색·간격은 여기서만 정의한다 */
      :root {
        --bg: #f9fbfd; /* 페이지 배경 */
        --surface: #ffffff; /* 카드 배경 */
        --card: #ffffff;
        --primary: #5f76e8; /* 메인색(면·막대·장식) */
        --primary-text: #4a60d6; /* 메인색 글자·흰 글자 배경용: 대비 4.5:1 이상(NFR-UX) */
        --primary-soft: #e9ecfc;
        --grad: linear-gradient(90deg, #7660de, #4f66dc);
        --red: #ff4f70;
        --sky: #01caf1;
        --green: #22ca80;
        --fg: #1c2d41; /* 제목 */
        --body: #626a73; /* 본문: 제시값 #6c757d 를 배경 위 4.5:1 확보하려고 조금 어둡게 */
        --muted: #626a73;
        --line: #edf2f9;
        --accent: var(--primary-text);
        --accent-soft: var(--primary-soft);
        --high: #11663a;
        --medium: #7a5200;
        --low: #a3261c;
        --radius: 12px;
        --shadow: 0 2px 12px rgba(0, 0, 0, 0.05);
        --gap: 24px;
        --section-gap: 32px;
        --side: 260px;
        font-size: 100%;
      }
      * {
        box-sizing: border-box;
      }
      body {
        margin: 0;
        font-family: Rubik, system-ui, -apple-system, "Apple SD Gothic Neo", "Malgun Gothic", sans-serif;
        font-size: 1rem; /* 16px 이상 (NFR-UX-03) */
        font-weight: 400;
        line-height: 1.6;
        color: var(--body);
        background: var(--bg);
      }
      h1,
      h2,
      h3,
      .brand {
        font-family: inherit;
        color: var(--fg);
      }
      h1 {
        margin: 0 0 4px;
        font-size: 1.5rem;
        font-weight: 600;
        line-height: 1.3;
      }
      h2 {
        margin: var(--section-gap) 0 12px;
        font-size: 1.25rem;
        font-weight: 500;
      }
      h3 {
        font-size: 1.0625rem;
        font-weight: 500;
      }
      main,
      .foot {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 32px;
      }
      main {
        padding-top: 24px;
      }
      .crumb {
        margin: 0 0 var(--section-gap);
        font-size: 0.875rem;
        color: var(--body);
      }
      .crumb span + span::before {
        content: "/";
        margin: 0 8px;
      }
      .skip {
        position: absolute;
        left: -9999px;
      }
      .skip:focus {
        left: 8px;
        top: 8px;
        background: var(--surface);
        padding: 8px;
        z-index: 40;
      }
      /* 좌측 사이드바 */
      .left-sidebar {
        position: fixed;
        top: 0;
        bottom: 0;
        left: 0;
        width: var(--side);
        z-index: 20;
        padding: 24px 0;
        background: var(--surface);
      }
      .brand {
        font-size: 1.5rem;
        font-weight: 600;
        text-decoration: none;
      }
      .left-sidebar .brand {
        display: block;
        padding: 0 24px 24px;
      }
      .left-sidebar ul {
        list-style: none;
        margin: 0;
        padding: 0;
      }
      .side-link {
        display: flex;
        align-items: center;
        gap: 12px;
        min-height: 48px;
        margin-right: 16px;
        padding: 0 24px;
        border-radius: 0 50px 50px 0;
        color: var(--body);
        text-decoration: none;
      }
      .side-link:hover {
        background: var(--primary-soft);
        color: var(--fg);
      }
      .side-link.active {
        background: var(--grad);
        color: #fff;
        font-weight: 500;
      }
      .ico {
        width: 20px;
        height: 20px;
        flex: none;
        fill: none;
        stroke: currentColor;
        stroke-width: 2;
        stroke-linecap: round;
        stroke-linejoin: round;
      }
      .page-wrapper {
        margin-left: var(--side);
        min-height: 100vh;
        min-width: 0;
      }
      main {
        min-width: 0;
      }
      /* 상단 헤더: 흰 배경 · 그림자 없음 · 오른쪽 검색 */
      .top {
        position: sticky;
        top: 0;
        z-index: 10;
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 12px;
        min-height: 72px;
        padding: 12px 32px;
        background: var(--surface);
      }
      .brand-m {
        display: none;
        margin-right: auto;
        white-space: nowrap;
      }
      .nav-toggle {
        display: none;
        border: 0;
        background: transparent;
        color: var(--fg);
        font-size: 1.5rem;
        padding: 0 8px;
      }
      .search {
        position: relative;
        width: min(320px, 100%);
        min-width: 0;
      }
      .search .ico {
        position: absolute;
        left: 14px;
        top: 50%;
        transform: translateY(-50%);
        color: var(--body);
        pointer-events: none;
      }
      .search input {
        width: 100%;
        min-height: 44px;
        padding: 0 16px 0 42px;
        border: 0;
        border-radius: 999px;
        background: var(--bg);
        color: var(--fg);
      }
      @media (max-width: 991px) {
        .left-sidebar {
          transform: translateX(-100%);
          transition: transform 0.2s ease-in;
          box-shadow: var(--shadow);
        }
        .nav-open .left-sidebar {
          transform: none;
        }
        .page-wrapper {
          margin-left: 0;
        }
        .nav-toggle,
        .brand-m {
          display: inline-block;
        }
        .top {
          padding: 8px 16px;
        }
        main,
        .foot {
          padding-left: 16px;
          padding-right: 16px;
        }
      }
      .foot {
        margin-top: 40px;
        padding-top: 24px;
        padding-bottom: 32px;
        border-top: 1px solid var(--line);
      }
      a {
        color: var(--primary-text);
      }
      :focus-visible {
        outline: 3px solid var(--primary-text);
        outline-offset: 2px;
      }
      /* 알림 카드: 둥근 모서리 + 왼쪽 4px 색 띠 */
      .notice,
      .check {
        margin: 16px 32px;
        overflow-wrap: anywhere;
        padding: 16px 20px;
        background: #fff8e6;
        border: 0;
        border-left: 4px solid #fdc16a;
        border-radius: var(--radius);
        box-shadow: var(--shadow);
        color: #5c4300;
      }
      .check {
        margin: var(--gap) 0;
      }
      button,
      select,
      input {
        font: inherit;
      }
      select,
      button {
        min-height: 44px;
      }
      select,
      input {
        border: 1px solid #dfe6ef;
        border-radius: 8px;
        background: var(--surface);
        color: var(--fg);
      }
      button {
        border-radius: 8px;
      }
      /* 카드 */
      .panel {
        margin: 0 0 var(--gap);
        padding: var(--gap);
        background: var(--surface);
        border-radius: var(--radius);
        box-shadow: var(--shadow);
      }
      .panel > h2:first-child {
        margin-top: 0;
      }
      /* 배지: 둥근 pill, 연한 배경 + 진한 글자 */
      .badge {
        display: inline-block;
        padding: 0 12px;
        border: 0;
        border-radius: 999px;
        background: var(--primary-soft);
        color: #3b4fc0;
        font-size: 0.875rem;
        font-weight: 500;
        line-height: 1.7;
      }
      .badge.ok {
        background: #dff7ec;
        color: var(--high);
      }
      .badge.warn {
        background: #fff1d6;
        color: var(--medium);
      }
      .badge.info {
        background: #d9f6fc;
        color: #00657a;
      }
      /* 한산 가능성: 색과 함께 글자·기호로도 구분한다 (NFR-UX-02) */
      .lh-high,
      .lh-medium,
      .lh-low {
        display: inline-block;
        padding: 0 12px;
        border-radius: 999px;
        font-weight: 500;
      }
      .lh-high {
        background: #dff7ec;
        color: var(--high);
      }
      .lh-medium {
        background: #fff1d6;
        color: var(--medium);
      }
      .lh-low {
        background: #ffe3e8;
        color: var(--low);
      }
      /* 작은 아웃라인 버튼 */
      .btn-outline {
        display: inline-flex;
        align-items: center;
        min-height: 44px;
        padding: 0 16px;
        border: 1px solid var(--primary-text);
        border-radius: 8px;
        color: var(--primary-text);
        font-size: 0.9375rem;
        font-weight: 500;
        text-decoration: none;
      }
      .btn-outline:hover {
        background: var(--primary-soft);
      }
      details summary {
        cursor: pointer;
      }
      .chat-open {
        position: fixed;
        right: 24px;
        bottom: 24px;
        padding: 0 20px;
        border: 0;
        border-radius: 999px;
        background: var(--grad);
        color: #fff;
        font-weight: 500;
        box-shadow: 0 4px 16px rgba(79, 102, 220, 0.4);
      }
      #chat {
        width: min(560px, calc(100% - 16px));
        max-height: 85vh;
        padding: 16px 24px;
        border: 0;
        border-radius: var(--radius);
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.18);
      }
      .chat-head {
        display: flex;
        justify-content: space-between;
        align-items: center;
      }
      .chat-head h2 {
        margin: 0;
      }
      .chat-log {
        max-height: 50vh;
        overflow-y: auto;
      }
      .msg {
        margin: 8px 0;
        padding: 8px 12px;
        border-radius: 8px;
        background: var(--bg);
      }
      .msg.me {
        background: var(--primary-soft);
        margin-left: 24px;
      }
      .chat-form {
        display: flex;
        gap: 8px;
        margin-top: 8px;
      }
      .chat-form input {
        flex: 1;
        min-height: 44px;
        padding: 0 8px;
      }
      .sr {
        position: absolute;
        width: 1px;
        height: 1px;
        overflow: hidden;
        clip: rect(0 0 0 0);
      }
    </style>
    <script>
      const nav = document.getElementById("nav-toggle")!;
      nav.addEventListener("click", () => {
        const open = document.body.classList.toggle("nav-open");
        nav.setAttribute("aria-expanded", String(open));
      });
    </script>
    <script>
      import { initFrame } from "../scripts/common";
      import { initChat } from "../scripts/chat";
      import { initSearch } from "../scripts/search";
      initFrame();
      initChat();
      initSearch();
    </script>
  </body>
</html>
