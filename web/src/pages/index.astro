---
// 피드(FR-FEED-01~07) + 조건 필터(FR-FLT-01~06). 화면 틀만 정적으로 만들고 추천은 브라우저가 자료 파일로 그린다
import Base from "../layouts/Base.astro";
---

<Base title="한산 — 덜 붐비는 나들이 추천">
  <h1 id="heading">이번 주말, 덜 붐빌 나들이 장소</h1>
  <form id="filters" class="filters" aria-label="추천 조건">
    <fieldset class="days">
      <legend>날짜</legend>
      <div id="weekend" class="weekend"></div>
      <label>다른 날짜 <select id="date" name="date"></select></label>
    </fieldset>
    <details id="more" class="more">
    <summary>조건 더 보기 <span id="more-summary"></span></summary>
    <div class="more-body">
    <label>출발 지역
      <select id="origin" name="origin"><option value="">선택 안 함</option></select>
    </label>
    <label>이동 시간
      <select id="minutes" name="minutes" disabled>
        <option value="30">약 30분 이내</option>
        <option value="60">약 1시간 이내</option>
        <option value="120">약 2시간 이내</option>
        <option value="" selected>제한 없음</option>
      </select>
    </label>
    <label>누구와
      <select id="companion" name="companion"><option value="">상관없음</option></select>
    </label>
    <fieldset class="indoor">
      <legend>실내·실외</legend>
      <label><input type="radio" name="indoor" value="" checked /> 상관없음</label>
      <label><input type="radio" name="indoor" value="indoor" /> 실내</label>
      <label><input type="radio" name="indoor" value="outdoor" /> 실외</label>
    </fieldset>
    </div>
    </details>
  </form>
  <p class="hint">이동 시간은 직선거리로 어림한 값이라 '약'으로 표시합니다.</p>
  <p id="count" class="sr" role="status" aria-live="polite"></p>
  <div id="relax"></div>
  <div id="feed"><p>추천을 불러오는 중입니다.</p></div>
</Base>

<style>
  .filters {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(200px, 100%), 1fr));
    gap: 12px;
    padding: 12px;
    background: var(--card);
    border: 1px solid var(--line);
  }
  .filters label {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .more {
    grid-column: 1 / -1;
  }
  .more summary {
    min-height: 44px;
    padding-top: 10px;
    font-weight: 700;
  }
  .more-body {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(200px, 100%), 1fr));
    gap: 12px;
    margin-top: 8px;
  }
  .filters fieldset {
    border: 0;
    margin: 0;
    padding: 0;
  }
  .filters .indoor label {
    flex-direction: row;
    align-items: center;
    min-height: 44px;
    gap: 8px;
  }
  .weekend {
    display: flex;
    gap: 8px;
    margin-bottom: 8px;
    min-height: 44px; /* 버튼이 늦게 들어와도 아래가 밀리지 않게(CLS) */
  }
  #feed {
    min-height: 100vh; /* 추천이 그려질 자리를 미리 잡아 하단이 밀려 내려가지 않게(CLS) */
  }
  .weekend button {
    flex: 1;
    border: 1px solid var(--line);
    background: var(--bg);
  }
  .weekend button[aria-pressed="true"] {
    background: var(--fg);
    color: var(--bg);
    font-weight: 700;
  }
  .hint {
    color: var(--muted);
  }
  :global(.type) {
    margin-top: 28px;
  }
  :global(.type-desc) {
    margin-top: 0;
    color: var(--muted);
  }
  :global(.cards) {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 12px;
    list-style: none;
    padding: 0;
  }
  :global(.card) {
    padding: 12px 14px;
    background: var(--card);
    border: 1px solid var(--line);
  }
  :global(.card h3) {
    margin: 0;
    font-size: 1.125rem;
  }
  :global(.card p) {
    margin: 4px 0;
  }
  :global(.card .where) {
    color: var(--muted);
  }
  :global(.card .basis) {
    color: var(--muted);
  }
  :global(.card details) {
    display: inline;
  }
  :global(.relax button) {
    margin: 4px 8px 4px 0;
  }
</style>

<script>
  import { initFeed } from "../scripts/feed";
  initFeed();
</script>
